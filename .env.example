# Base path of the app. "/havana-barberia/" while served from GitHub Pages,
# "/" once the custom domain is active.
VITE_BASE=/havana-barberia/
# Data source: "mock" (local demo data). "supabase" will be added in a later milestone.
VITE_DATA_SOURCE=mock
# Show the /__ui component gallery (dev and preview only).
VITE_UI_GALLERY=true
# Supabase (public anon values only; never put the service key here).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
